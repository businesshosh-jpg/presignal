  "immutable_fields": ["schema_version", "system_version", "prediction_id", "episode_id", "provider", "model", "information_arm", "pack_id", "pack_fingerprint", "forecast_cutoff_ts", "prediction_target_type", "prediction_target_id", "primary_event_id", "secondary_event_ids"]
